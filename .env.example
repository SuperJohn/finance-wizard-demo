# Copy to .env (gitignored). All optional.
# Path to a Finance Lake database (default: ../finance-lake-demo/lake.duckdb, i.e. a sibling checkout).
FW_LAKE_PATH=
FW_PORT=8765
FW_MODEL=gemma3:27b
OLLAMA_URL=http://127.0.0.1:11434
# Optional cloud model (OpenAI-compatible chat completions). Off unless set. Never commit a real key.
FW_CLOUD_BASE_URL=
FW_CLOUD_API_KEY=
FW_CLOUD_MODEL=
# 1 = ignore the lake and use the built-in synthetic fixture
FW_FIXTURE=0
